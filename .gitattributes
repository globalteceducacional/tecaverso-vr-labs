* text=auto
*.cs text eol=lf
*.asmdef text eol=lf
*.json text eol=lf
*.md text eol=lf
*.unity text eol=lf whitespace=-blank-at-eol
*.prefab text eol=lf whitespace=-blank-at-eol
*.mat text eol=lf whitespace=-blank-at-eol
*.asset text=auto whitespace=-blank-at-eol
*.meta text eol=lf whitespace=-blank-at-eol
*.png binary
*.jpg binary
*.exr binary
*.fbx binary
*.wav binary
*.mp3 binary
*.webm binary
*.cubemap filter=lfs diff=lfs merge=lfs -text
# Audited legacy Biology sources: retain source binaries without bloating Git objects.
SourceAssets/BiologyLegacy/**/*.png filter=lfs diff=lfs merge=lfs -text
SourceAssets/BiologyLegacy/**/*.fbx filter=lfs diff=lfs merge=lfs -text
SourceAssets/BiologyLegacy/**/*.FBX filter=lfs diff=lfs merge=lfs -text
Assets/_Project/Art/Biology/**/*.fbx filter=lfs diff=lfs merge=lfs -text
Assets/_Project/Art/Biology/**/*.FBX filter=lfs diff=lfs merge=lfs -text
