  m_Script: {fileID: 11500000, guid: 97a9f8307a74cd044809fa753483e437, type: 3}
  m_Name: HubCatalog
  m_EditorClassIdentifier: Assembly-CSharp::Tecaverso.Hub.HubCatalog
  disciplines:
  - title: "F\xEDsica"
    description: "Movimento, energia, ondas e fen\xF4menos do mundo f\xEDsico."
    accent: {r: 0.15686275, g: 0.30588236, b: 0.627451, a: 1}
    icon: {fileID: 21300000, guid: addda49e2b9e806408542fd44f12cf46, type: 3}
    contents:
    - title: "Movimento e for\xE7as"
      description: "Explore o lan\xE7amento obl\xEDquo: varie o \xE2ngulo, a velocidade
        inicial, a altura e a gravidade e observe a trajet\xF3ria e os vetores."
      objective: "Relacionar velocidade, gravidade, alcance e altura m\xE1xima."
      icon: {fileID: 21300000, guid: b960a8b17a8b5c44da5c37529e2f5112, type: 3}
      scenePath: Assets/_Project/Laboratories/Physics/ObliqueLaunch/Scenes/ObliqueLaunch.unity
    - title: Plano inclinado
      description: "Investigue peso, normal e atrito em um bloco sobre uma rampa.
        Dispon\xEDvel na explora\xE7\xE3o individual."
      objective: "Relacionar inclina\xE7\xE3o, equil\xEDbrio, atrito e acelera\xE7\xE3o."
      icon: {fileID: 21300000, guid: a88589cbabe651d47b99f40ffa953386, type: 3}
      scenePath: Assets/_Project/Laboratories/Physics/InclinedPlane/Scenes/InclinedPlane.unity
    - title: "Associa\xE7\xE3o de resistores"
      description: "Monte circuitos em s\xE9rie e paralelo com fios e instrumentos
        XR."
      objective: "Relacionar resist\xEAncia, tens\xE3o, corrente e pot\xEAncia da
        l\xE2mpada."
      icon: {fileID: 21300000, guid: 8e8a4f44e718e75419faec5c4fe911ff, type: 3}
      scenePath: Assets/_Project/Laboratories/Physics/ResistorCircuits/Scenes/ResistorCircuits.unity
    - title: Termologia
      description: "Explore press\xE3o, volume e temperatura com um pist\xE3o, part\xEDculas
        e instrumentos XR. Compare transforma\xE7\xF5es e o trabalho do g\xE1s."
      objective: "Relacionar as vari\xE1veis de estado e o trabalho realizado pelo
        g\xE1s."
      icon: {fileID: 21300000, guid: 3e885bd86df25994e8b4d13a9c2ecbe2, type: 3}
      scenePath: Assets/_Project/Laboratories/Physics/Thermology/Scenes/Thermology.unity
    - title: "Ondulat\xF3ria"
      description: "Produza pulsos e ondas em uma corda. Explore reflex\xE3o, frequ\xEAncia,
        comprimento de onda e ondas estacion\xE1rias."
      objective: "Relacionar propaga\xE7\xE3o, oscila\xE7\xE3o e superposi\xE7\xE3o
        por observa\xE7\xE3o e medi\xE7\xE3o."
      icon: {fileID: 21300000, guid: 54accea0adcb27f4e9de34540603ab92, type: 3}
      scenePath: Assets/_Project/Laboratories/Physics/Waves/Scenes/Waves.unity
    - title: "Gravita\xE7\xE3o"
      description: "Investigue a atra\xE7\xE3o gravitacional, lance um sat\xE9lite
        e observe as \xF3rbitas dos oito planetas. Explora\xE7\xE3o individual."
      objective: "Relacionar massa, dist\xE2ncia, for\xE7a gravitacional e movimento
        orbital."
      icon: {fileID: 21300000, guid: db4bf1f1d5b09c449aeee8f9e4f9ce22, type: 3}
      scenePath: Assets/_Project/Laboratories/Physics/Gravitation/Scenes/Gravitation.unity
  - title: "Qu\xEDmica"
    description: "Mat\xE9ria, propriedades, rea\xE7\xF5es e transforma\xE7\xF5es."
    accent: {r: 0.4627451, g: 0.28235295, b: 0.9098039, a: 1}
    icon: {fileID: 21300000, guid: 2c42d3c5abdc0a140ac2c1a26c3b0f33, type: 3}
    contents:
    - title: "Estrutura da mat\xE9ria"
      description: "Mockup: explore \xE1tomos, mol\xE9culas e propriedades da mat\xE9ria."
      objective: "Reconhecer modelos e estruturas da mat\xE9ria."
      icon: {fileID: 21300000, guid: 2c42d3c5abdc0a140ac2c1a26c3b0f33, type: 3}
      scenePath: 
    - title: "Rea\xE7\xF5es qu\xEDmicas"
      description: "Mockup: observe reagentes e produtos em transforma\xE7\xF5es
        qu\xEDmicas."
      objective: "Identificar evid\xEAncias de uma rea\xE7\xE3o qu\xEDmica."
      icon: {fileID: 21300000, guid: 2c42d3c5abdc0a140ac2c1a26c3b0f33, type: 3}
      scenePath: 
    - title: "Solu\xE7\xF5es"
      description: "Mockup: prepare misturas e compare concentra\xE7\xF5es."
