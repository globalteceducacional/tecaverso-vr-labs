      objective: "Relacionar coordenadas, vetores, \xE1reas e volumes por constru\xE7\xE3o
        e observa\xE7\xE3o."
      icon: {fileID: 21300000, guid: b3d2cc4a6f464ce4ab9633f8b98da50e, type: 3}
