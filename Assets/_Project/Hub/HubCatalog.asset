      icon: {fileID: 21300000, guid: 2c42d3c5abdc0a140ac2c1a26c3b0f33, type: 3}
      scenePath: 
  - title: Biologia
    description: Vida, organismos, sistemas e ecossistemas.
    accent: {r: 0.24313726, g: 0.827451, b: 0.6117647, a: 1}
    icon: {fileID: 21300000, guid: 36628de42318d7146ba842258cdc7e57, type: 3}
    contents:
    - title: "C\xE9lulas"
      description: "Mockup: conhe\xE7a estruturas e fun\xE7\xF5es celulares."
