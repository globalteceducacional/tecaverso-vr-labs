      icon: {fileID: 21300000, guid: 36628de42318d7146ba842258cdc7e57, type: 3}
      scenePath: 
    - title: Ecossistemas
      description: "Mockup: observe organismos e rela\xE7\xF5es ecol\xF3gicas."
